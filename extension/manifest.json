{
  "manifest_version": 3,
  "name": "hstry sync",
  "version": "0.4.26",
  "description": "Capture ChatGPT personal and project conversations into the private local hstry archive.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "hstry sync",
    "default_popup": "popup.html"
  },
  "version_name": "0.4.26 HSTRY automatic continuation",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "live-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "handoff-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
